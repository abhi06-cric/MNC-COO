# ==============================================================================
# MNC Executive Portal - Environment Configuration Template
# ==============================================================================

# Server Network Port
PORT=5001

# Production Environment flag ('development' or 'production')
NODE_ENV=production

# MongoDB Production Connection URI (Atlas Replica Set with TLS)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=MNC

# JWT & Cookie Signing Secrets (Use high-entropy 64+ char random strings)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_in_production
COOKIE_SECRET=replace_with_another_secure_random_string_for_cookie_signing

# Client Applications Allowed Origins (comma-separated for CORS whitelist)
CLIENT_URL=https://portal.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
ALLOWED_ORIGINS=https://portal.yourdomain.com,https://admin.yourdomain.com

# ==============================================================================
# SMTP Protocol Configuration (Google Gmail or Enterprise SMTP Relay)
# ==============================================================================
# For Google Gmail:
GOOGLE_EMAIL=your-admin-account@gmail.com
GOOGLE_APP_PASSWORD=xxxx xxxx xxxx xxxx

# For Enterprise / Custom SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxx
# SMTP_FROM="MNC Security Team" <security@yourdomain.com>

# Database Backup Destination
BACKUP_DIR=./backups
